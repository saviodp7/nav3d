#!/usr/bin/env bash

set -euo pipefail

scenario="${1:-takeoff_test}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "${scenario}" in
  takeoff_test)
    if gz topic -l | grep -Eq '^/world/.*/clock$'; then
      echo "A Gazebo world is already running; stop it before the takeoff test." >&2
      exit 3
    fi
    exec ros2 launch nav3d_system_tests takeoff_test.launch.py "$@"
    ;;
  *)
    echo "Unknown Nav3D system-test scenario: ${scenario}" >&2
    echo "Available scenarios: takeoff_test" >&2
    exit 2
    ;;
esac
