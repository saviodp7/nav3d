<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="x500">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import x500 urdf file -->
    <xacro:include filename="$(find nav3d_uavs)/x500/description/urdf/x500.urdf.xacro"/>

    <!-- Import control_xacro -->
    <!-- <xacro:include filename="x500.ros2_control.xacro" />

    <xacro:x500_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
