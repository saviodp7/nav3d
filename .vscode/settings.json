{
  "workbench.editor.enablePreview": false,
  "python.terminal.activateEnvironment": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "clang-format.style": "file",
  "clang-format.executable": "/usr/bin/clang-format",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },
  "ruff.nativeServer": "auto",
  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[cmake]": {
    "editor.defaultFormatter": "cheshirekow.cmake-format"
  },
  "cmakeFormat.executable": "cmake-format",
  "testMate.cpp.test.advancedExecutables": [
    {
      "pattern": "/ros2_ws/build/nav3d_*/test_*",
      "cwd": "${absDirpath}",
      "envFile": "/ros2_ws/.testmate-env.json",
      "dependsOn": [
        "/ros2_ws/.testmate-env.json"
      ],
      "exclude": "files.exclude",
      "gtest": {
        "testGrouping": {
          "groupByLabel": {
            "label": "${absDirpath[-1:]}",
            "groupByExecutable": {
              "label": "${baseFilename}"
            }
          }
        }
      }
    }
  ],
  "testMate.cpp.test.parallelExecutionLimit": 1,
  "testMate.cpp.debug.configTemplate": {
    "type": "cppdbg",
    "MIMode": "gdb",
    "program": "${exec}",
    "args": "${argsArray}",
    "cwd": "${cwd}",
    "environment": "${envObjArray}"
  },
  "python.autoComplete.extraPaths": [
    "/opt/ros/jazzy/opt/gz_sim_vendor/lib/python",
    "/opt/ros/jazzy/opt/sdformat_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_transport_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_msgs_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_math_vendor/lib/python",
    "/opt/ros/jazzy/lib/python3.12/site-packages"
  ],
  "python.analysis.extraPaths": [
    "/opt/ros/jazzy/opt/gz_sim_vendor/lib/python",
    "/opt/ros/jazzy/opt/sdformat_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_transport_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_msgs_vendor/lib/python",
    "/opt/ros/jazzy/opt/gz_math_vendor/lib/python",
    "/opt/ros/jazzy/lib/python3.12/site-packages"
  ]
}
